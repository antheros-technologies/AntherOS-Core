    # Core Commands
    table.add_row("refresh / update", "Quietly synchronizes global package mirrors.", "sudo bolt refresh")
    table.add_row("install <package>", "Installs software without technical terminal spam.", "sudo bolt install vlc")
    table.add_row("remove <package>", "Uninstalls apps and purges leftover configurations.", "sudo bolt remove gimp")
