#!/usr/bin/env python3
import sys
import os
import subprocess
import glob
from rich.console import Console
from rich.table import Table
from rich.panel import Panel

console = Console()

BRAND = "[bold cyan]⚡ BOLT[/bold cyan]"
SUCCESS = "[bold green]✓[/bold green]"
WARN = "[bold yellow]⚠[/bold yellow]"
ERROR = "[bold red]✗[/bold red]"

